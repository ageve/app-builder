{
  "name": "mobile-ops",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run src/cli/main.ts",
    "web:dev": "cd dashboard && bun run dev",
    "web:build": "cd dashboard && bun run build",
    "docker:runtime": "docker compose -f .docker/dashboard/docker-compose.yml up -d --build --remove-orphans app-builder-runtime",
    "docker:runtime:down": "docker compose -f .docker/dashboard/docker-compose.yml stop -t 1 app-builder-runtime",
    "docker:up": "docker compose -f .docker/dashboard/docker-compose.yml up --build --remove-orphans",
    "docker:down": "docker compose -f .docker/dashboard/docker-compose.yml down --remove-orphans",
    "dev": "bun run scripts/dev.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@duckdb/node-api": "^1.5.1-r.1",
    "@duckdb/node-bindings-darwin-arm64": "^1.4.3-r.1",
    "@inquirer/prompts": "^3.3.0",
    "axios": "^1.12.2",
    "chalk": "^5.3.0",
    "commander": "^10.0.0",
    "dayjs": "^1.11.10",
    "death": "^1.1.0",
    "dotenv": "^16.0.3",
    "enquirer": "^2.4.1",
    "fetch-blob": "^4.0.0",
    "form-data": "^4.0.0",
    "form-data-encoder": "^4.1.0",
    "formdata-node": "^6.0.3",
    "fs-extra": "^11.2.0",
    "git-describe": "^4.1.1",
    "leven": "^4.0.0",
    "lodash": "^4.17.21",
    "moment-timezone": "^0.5.41",
    "nanoid": "^5.0.4",
    "neverthrow": "^8.2.0",
    "node-fetch": "^3.3.2",
    "node-git": "^0.0.0",
    "open": "^10.0.3",
    "picocolors": "^1.1.1",
    "properties-reader": "^2.2.0",
    "qiniu": "^7.10.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.7.3",
    "undici": "^7.16.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "yargs": "^18.0.0",
    "zod": "^4.0.5",
    "zx": "^7.2.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "@types/death": "^1.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.14.191",
    "@types/node": "^18.14.6",
    "@types/node-fetch": "^2.6.2",
    "@types/properties-reader": "^2.1.1",
    "@types/uuid": "^9.0.1",
    "@types/yargs": "^17.0.33",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6"
  }
}
